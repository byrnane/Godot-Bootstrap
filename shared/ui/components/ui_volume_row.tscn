[gd_scene format=3]

[ext_resource type="Script" path="res://shared/ui/components/ui_volume_row.gd" id="script"]

[node name="UiVolumeRow" type="VBoxContainer"]
script = ExtResource("script")
custom_minimum_size = Vector2(460, 64)
theme_override_constants/separation = 4

[node name="Header" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="Title" type="Label" parent="Header"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"UiLabel"
text = ""
size_flags_horizontal = 3

[node name="Value" type="Label" parent="Header"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"UiSmall"
text = "100%"

[node name="Slider" type="HSlider" parent="."]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(0, 32)
max_value = 1.0
step = 0.01
value = 1.0

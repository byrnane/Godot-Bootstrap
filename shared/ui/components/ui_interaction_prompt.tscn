[gd_scene format=3]

[ext_resource type="Script" path="res://shared/ui/components/ui_interaction_prompt.gd" id="script"]

[ext_resource type="PackedScene" path="res://shared/ui/components/ui_key_hint.tscn" id="key"]

[node name="UiInteractionPrompt" type="PanelContainer"]
script = ExtResource("script")
custom_minimum_size = Vector2(340, 60)
mouse_filter = 2

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 12
mouse_filter = 2

[node name="Row" type="HBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12
mouse_filter = 2

[node name="Key" parent="Margin/Row" instance=ExtResource("key")]
unique_name_in_owner = true
layout_mode = 2

[node name="Text" type="Label" parent="Margin/Row"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"UiLabel"
text = ""
mouse_filter = 2

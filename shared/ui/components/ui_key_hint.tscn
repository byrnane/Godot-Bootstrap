[gd_scene format=3]

[ext_resource type="Script" path="res://shared/ui/components/ui_text_panel.gd" id="script"]

[node name="UiKeyHint" type="PanelContainer"]
script = ExtResource("script")
custom_minimum_size = Vector2(40, 36)
theme_type_variation = &"UiRaised"
mouse_filter = 2
text = "E"

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 6
theme_override_constants/margin_top = 6
theme_override_constants/margin_right = 6
theme_override_constants/margin_bottom = 6
mouse_filter = 2

[node name="Content" type="VBoxContainer" parent="Margin"]
layout_mode = 2
mouse_filter = 2

[node name="Caption" type="Label" parent="Margin/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"UiCaption"
text = ""
visible = false

[node name="Text" type="Label" parent="Margin/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"UiLabel"
text = "E"
horizontal_alignment = 1
mouse_filter = 2

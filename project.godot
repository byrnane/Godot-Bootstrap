; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Game Template"
run/main_scene="res://main/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

AppContext="*res://core/context/app_context.gd"
SessionContext="*res://core/context/session_context.gd"
LocalizationManager="*res://core/services/localization_manager.gd"
SettingsManager="*res://core/services/settings_manager.gd"
SaveManager="*res://core/services/save_manager.gd"
AudioManager="*res://core/services/audio_manager.gd"
SceneRouter="*res://core/services/scene_router.gd"
UiShell="*res://core/services/ui_shell/ui_shell.tscn"
AppFlow="*res://core/flow/app_flow.gd"

[gui]

theme/custom="res://shared/ui/theme/scifi_dark_theme.tres"

[input]

ui_cancel={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194305,"physical_keycode":0,"key_label":4194305,"unicode":0,"location":0,"echo":false,"script":null)
]
}
ui_pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194310,"physical_keycode":0,"key_label":4194310,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[internationalization]

locale/translations=PackedStringArray("res://translations/UI.en.translation", "res://translations/UI.ru.translation")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

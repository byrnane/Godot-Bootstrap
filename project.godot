; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Game Template"
run/main_scene="res://main/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[audio]

general/default_playback_type.web=0

[autoload]

AppContext="*res://core/context/app_context.gd"
SessionContext="*res://core/context/session_context.gd"
GameConfig="*res://core/context/game_config.gd"
LocalizationManager="*res://core/services/localization_manager.gd"
SettingsManager="*res://core/services/settings_manager.gd"
SaveManager="*res://core/services/save_manager.gd"
AutosaveManager="*res://core/services/autosave_manager.gd"
AudioManager="*res://core/services/audio_manager.gd"
InputManager="*res://core/services/input_manager.gd"
TransitionManager="*res://core/services/transition_manager.gd"
SceneRouter="*res://core/services/scene_router.gd"
UiFeedback="*res://core/services/ui_feedback.gd"
UiShell="*res://core/services/ui_shell/ui_shell.tscn"
AppFlow="*res://core/flow/app_flow.gd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"
CyclopsAutoload="*res://addons/cyclops_level_builder/cyclops_autoload.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]

export/convert_text_resources_to_binary=false

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg", "res://addons/cyclops_level_builder/plugin.cfg", "res://addons/template_export/plugin.cfg")

[gui]

theme/custom="res://shared/ui/theme/neutral_theme.tres"


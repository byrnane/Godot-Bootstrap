[gd_scene format=3]

[ext_resource type="Script" path="res://features/main_menu/main_menu.gd" id="script"]

[ext_resource type="Texture2D" path="res://shared/ui/theme/art/menu_background.svg" id="background"]
[ext_resource type="Script" path="res://shared/ui/components/ui_button.gd" id="button_script"]

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("script")

[node name="Background" type="PanelContainer" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"UiCanvas"
mouse_filter = 2

[node name="Artwork" type="TextureRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
texture = ExtResource("background")
expand_mode = 1
stretch_mode = 6
mouse_filter = 2

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 80
theme_override_constants/margin_top = 80
theme_override_constants/margin_right = 80
theme_override_constants/margin_bottom = 80
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Column" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Margin/Column"]
layout_mode = 2
theme_type_variation = &"UiHero"
text = "UI_TEMPLATE_TITLE"


[node name="Subtitle" type="Label" parent="Margin/Column"]
layout_mode = 2
theme_type_variation = &"UiMuted"
text = "UI_TEMPLATE_SUBTITLE"


[node name="Space" type="Control" parent="Margin/Column"]
layout_mode = 2
custom_minimum_size = Vector2(0, 48)

[node name="Actions" type="VBoxContainer" parent="Margin/Column"]
layout_mode = 2
custom_minimum_size = Vector2(360, 0)
size_flags_horizontal = 0
theme_override_constants/separation = 12

[node name="ContinueButton" type="Button" parent="Margin/Column/Actions"]
script = ExtResource("button_script")
icon_role = &"arrow"
icon_alignment = 2
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(0, 56)
theme_type_variation = &"UiButtonPrimary"
text = "UI_CONTINUE"
alignment = 0

[node name="ContinueHint" type="Label" parent="Margin/Column/Actions"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"UiSmall"
text_overrun_behavior = 3

[node name="Divider" type="HSeparator" parent="Margin/Column/Actions"]
layout_mode = 2

[node name="NewGameButton" type="Button" parent="Margin/Column/Actions"]
script = ExtResource("button_script")
icon_role = &"play"
icon_alignment = 2
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(0, 56)
theme_type_variation = &"UiButtonSecondary"
text = "UI_NEW_GAME"
alignment = 0

[node name="SaveSlotsButton" type="Button" parent="Margin/Column/Actions"]
script = ExtResource("button_script")
icon_role = &"save"
icon_alignment = 2
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(0, 56)
theme_type_variation = &"UiButtonGhost"
text = "UI_SAVE_SLOTS"
alignment = 0

[node name="SettingsButton" type="Button" parent="Margin/Column/Actions"]
script = ExtResource("button_script")
icon_role = &"gear"
icon_alignment = 2
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(0, 56)
theme_type_variation = &"UiButtonGhost"
text = "UI_SETTINGS"
alignment = 0

[node name="QuitButton" type="Button" parent="Margin/Column/Actions"]
script = ExtResource("button_script")
icon_role = &"close"
icon_alignment = 2
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(0, 56)
theme_type_variation = &"UiButtonGhost"
text = "UI_QUIT"
alignment = 0
